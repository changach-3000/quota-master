# Copy to .env and adjust. Never commit .env.
# Local Postgres 16 (Homebrew, port 5433). The test DB name must end in _test:
# the Vitest setup wipes and rebuilds it on every run.
DATABASE_URL="postgresql://YOUR_MAC_USER@localhost:5433/quota_master"
TEST_DATABASE_URL="postgresql://YOUR_MAC_USER@localhost:5433/quota_master_test"

# Temporary password-less demo sign-in at /dev-login (development only).
DEV_LOGIN=1
